[Unit]
Description=RoseKhlifa blog online writing workspace
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rosekhlifa-blog
Group=rosekhlifa-blog
WorkingDirectory=/opt/rosekhlifa-blog/source
Environment=HOME=/opt/rosekhlifa-blog/editor-home
Environment=NODE_ENV=development
Environment=SITE_URL=https://blog.rosekhlifa.com
Environment=ASTRO_WHONO_BASE_PATH=/
Environment=ASTRO_TELEMETRY_DISABLED=1
ExecStart=/usr/bin/node /opt/rosekhlifa-blog/source/node_modules/astro/bin/astro.mjs dev --config ../deploy/admin/astro-online.config.mjs --host 127.0.0.1 --port 14321
Restart=always
RestartSec=5
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/rosekhlifa-blog/source /opt/rosekhlifa-blog/editor-home
MemoryMax=2G
CPUQuota=200%
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
