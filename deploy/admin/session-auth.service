[Unit]
Description=RoseKhlifa blog session authentication
After=network.target

[Service]
Type=simple
User=rosekhlifa-blog-auth
Group=rosekhlifa-blog-auth
ExecStart=/usr/bin/python3 /opt/rosekhlifa-blog/deploy/admin/session-auth.py --config /opt/rosekhlifa-blog/session-auth/credentials.json --port 14322
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/rosekhlifa-blog/session-auth/credentials.json
RestrictAddressFamilies=AF_INET AF_UNIX
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
