@@ -41,6 +41,7 @@ http {
         default 0;
         ~^https://51\.83\.101\.143:18181$ 1;
         ~^https://blog\.rosekhlifa\.com:18181$ 1;
+        ~^https://blog\.rosekhlifa\.com$ 1;
     }
 
     map "$is_write_request:$is_upgrade_request:$is_trusted_origin" $reject_origin {
@@ -68,8 +69,8 @@ http {
         port_in_redirect off;
         error_page 497 https://$http_host$request_uri;
 
-        auth_basic "Blog writing";
-        auth_basic_user_file /etc/admin/htpasswd;
+        auth_request /_auth_check;
+        error_page 401 = @login_required;
         add_header Cache-Control "no-store" always;
         add_header X-Content-Type-Options "nosniff" always;
         add_header Referrer-Policy "same-origin" always;
@@ -80,11 +81,52 @@ http {
         }
 
         location = /_admin-health {
-            auth_basic off;
+            auth_request off;
             default_type text/plain;
             return 200 "ok\n";
         }
 
+        location = /_auth_check {
+            internal;
+            auth_request off;
+            proxy_pass http://127.0.0.1:14322/check;
+            proxy_pass_request_body off;
+            proxy_set_header Content-Length "";
+            proxy_set_header Cookie $http_cookie;
+            proxy_set_header Authorization $http_authorization;
+            proxy_set_header X-Real-IP $http_x_real_ip;
+        }
+
+        location @login_required {
+            auth_request off;
+            if ($http_accept ~* "text/html") {
+                return 303 /admin/login/?next=$request_uri;
+            }
+            return 401;
+        }
+
+        location = /admin/login {
+            auth_request off;
+            return 308 /admin/login/;
+        }
+
+        location = /admin/login/ {
+            auth_request off;
+            proxy_pass http://127.0.0.1:14322/login;
+            proxy_set_header Host $http_host;
+            proxy_set_header Origin $http_origin;
+            proxy_set_header Cookie $http_cookie;
+            proxy_set_header X-Real-IP $http_x_real_ip;
+        }
+
+        location = /admin/logout/ {
+            auth_request off;
+            proxy_pass http://127.0.0.1:14322/logout;
+            proxy_set_header Host $http_host;
+            proxy_set_header Origin $http_origin;
+            proxy_set_header Cookie $http_cookie;
+        }
+
         location = /_publish/status {
             alias /srv/publish-state/status.json;
             default_type application/json;
